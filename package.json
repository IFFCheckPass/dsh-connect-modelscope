{
  "name": "dsh-connect-modelscope",
  "displayName": "DSH Connect ModelScope",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "author": "IFFCheckPass",
  "description": "把魔搭社区（ModelScope）接入 DeepSeek Harness：「模型」设置页出现 ModelScope 条目，对话栏仅在选中魔搭模型时显示剩余魔粒，插件设置页填访问令牌并勾选要发布的模型。",
  "keywords": ["dsh-plugin", "deepseek-harness", "modelscope", "model-provider", "magicube"],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "prices.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IFFCheckPass/dsh-connect-modelscope.git"
  },
  "homepage": "https://github.com/IFFCheckPass/dsh-connect-modelscope#readme",
  "bugs": {
    "url": "https://github.com/IFFCheckPass/dsh-connect-modelscope/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0",
    "@earendil-works/pi-ai": ">=0.85.1 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    }
  }
}
